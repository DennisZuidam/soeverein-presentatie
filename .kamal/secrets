# Kamal leest secrets hieruit. Dit bestand bevat GEEN echte secret: het
# verwijst alleen naar een env-var die je vóór de opname zet (buiten beeld):
#
#   export KAMAL_REGISTRY_PASSWORD=<ghcr-token met write:packages>
#
# Zo blijft de sleutel uit de opname en uit git.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
